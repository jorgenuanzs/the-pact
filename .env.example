# Docker Compose loads `.env` automatically. Copy this file with `make init`,
# then replace both blank secrets before running `make dev`.
#
# Use URL-safe values because the database password is included in a PostgreSQL
# connection URL. For example: `openssl rand -hex 32`.

COMPOSE_PROJECT_NAME=the-pact
PACT_SERVER_IMAGE=the-pact-server:dev
PACT_HTTP_PORT=8080

PACT_DB_NAME=pact
PACT_DB_USER=pact
PACT_DB_PASSWORD=

# Must contain at least 24 characters.
PACT_LOCAL_API_TOKEN=
PACT_LOCAL_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001

PACT_DATABASE_TIMEOUT=5s
PACT_DATABASE_STATEMENT_TIMEOUT=15s
PACT_DATABASE_LOCK_TIMEOUT=5s
PACT_SHUTDOWN_TIMEOUT=10s
PACT_LOG_LEVEL=debug

# Build metadata for images created directly by Docker Compose.
PACT_VERSION=dev
PACT_COMMIT=unknown
PACT_BUILD_DATE=unknown
