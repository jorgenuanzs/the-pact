# Docker Compose loads `.env` automatically. Copy this file with `make init`,
# then replace both blank secrets before running `make dev`.
#
# Use URL-safe values because the database password is included in a PostgreSQL
# connection URL. For example: `openssl rand -hex 32`.

COMPOSE_PROJECT_NAME=the-pact
PACT_SERVER_IMAGE=the-pact-server:dev
PACT_HTTP_PORT=8080

PACT_DB_NAME=pact
PACT_DB_USER=pact
PACT_DB_PASSWORD=

# Must contain at least 24 characters.
PACT_LOCAL_API_TOKEN=
PACT_LOCAL_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001

PACT_DATABASE_TIMEOUT=5s
PACT_DATABASE_STATEMENT_TIMEOUT=15s
PACT_DATABASE_LOCK_TIMEOUT=5s
PACT_SHUTDOWN_TIMEOUT=10s
PACT_LOG_LEVEL=debug
PACT_PUBLIC_URL=http://127.0.0.1:8080

# Public repositories work without a token. Private repositories require a
# fine-grained token or GitHub App installation token with read-only access.
PACT_GITHUB_API_URL=https://api.github.com
PACT_GITHUB_WEB_URL=https://github.com
PACT_GITHUB_TOKEN=
PACT_GITHUB_TIMEOUT=10s
# Use 0s to disable polling; explicit API, CLI, and MCP sync remain available.
PACT_GITHUB_SYNC_INTERVAL=0s

# Optional GitHub App integration for private repositories and repository
# selection in Pact Control. Configure every value in this group together.
# Keep "Request user authorization during installation" disabled. Configure
# both the Callback URL and Setup URL as:
#   ${PACT_PUBLIC_URL}/v1/integrations/github/callback
# Configure the webhook URL as:
#   ${PACT_PUBLIC_URL}/v1/integrations/github/webhook
PACT_GITHUB_APP_ID=
PACT_GITHUB_APP_SLUG=
PACT_GITHUB_APP_CLIENT_ID=
PACT_GITHUB_APP_CLIENT_SECRET=
# Base64 of the complete RSA PEM file, without line wrapping.
PACT_GITHUB_APP_PRIVATE_KEY_BASE64=
PACT_GITHUB_APP_WEBHOOK_SECRET=

# Build metadata for images created directly by Docker Compose.
PACT_VERSION=dev
PACT_COMMIT=unknown
PACT_BUILD_DATE=unknown
