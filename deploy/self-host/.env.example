# Use the version from the GitHub release you downloaded. Avoid `latest` in production.
PACT_SERVER_IMAGE=ghcr.io/jorgenuanzs/the-pact:VERSION

# PACT binds only to loopback. Put Caddy, Traefik, or Nginx with TLS in front.
PACT_HTTP_PORT=8080
PACT_PUBLIC_URL=https://pact.example.com

# Generate separate URL-safe values, for example with `openssl rand -hex 32`.
PACT_DB_PASSWORD=
PACT_SETUP_TOKEN=
PACT_LOCAL_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
PACT_BACKUP_RETENTION_DAYS=30
PACT_LOG_LEVEL=info

# Optional GitHub App integration. Configure the complete group or leave it empty.
PACT_GITHUB_API_URL=https://api.github.com
PACT_GITHUB_WEB_URL=https://github.com
PACT_GITHUB_APP_ID=
PACT_GITHUB_APP_SLUG=
PACT_GITHUB_APP_CLIENT_ID=
PACT_GITHUB_APP_CLIENT_SECRET=
PACT_GITHUB_APP_PRIVATE_KEY_BASE64=
PACT_GITHUB_APP_WEBHOOK_SECRET=
PACT_GITHUB_TIMEOUT=10s
PACT_GITHUB_SYNC_INTERVAL=0s
